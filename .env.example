# Copy to .env.local for local development, or set these in your host.

# Public origin used in emails, share links and Stripe redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3100

# Signs session cookies and share links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated into data/session.key on first boot.
SESSION_SECRET=

# --- Email -----------------------------------------------------------------
# With no RESEND_API_KEY the app runs in outbox mode: messages are written to
# the `outbox` table and the sign-in link is shown on screen. Fine locally,
# NOT acceptable on a public deployment.
RESEND_API_KEY=
MAIL_FROM="FireLogbook <hello@yourdomain.co.uk>"

# --- Billing ---------------------------------------------------------------
# Without these, checkout runs against a local simulator (no card, no charge).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Optional: pin a browser for PDF export if it is not in a standard location.
BROWSER_PATH=
