# Copy to .env.local for local development, or set these in your host.

# --- Database ---------------------------------------------------------------
# Neon Postgres connection string. Required: the app will not start without it.
# On Vercel, the Neon integration sets DATABASE_URL for you.
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# --- Photo storage ----------------------------------------------------------
# Vercel Blob store token. Connecting a Blob store to the Vercel project sets
# this automatically. Without it, photos are stored in Neon (check_photos) in
# production and on local disk in development.
BLOB_READ_WRITE_TOKEN=

# Public origin used in emails, share links and Stripe redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3100

# Signs session cookies, share links and unsubscribe links. REQUIRED in
# production, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local development falls back to a fixed key, so it can be left empty.
SESSION_SECRET=

# --- Email -----------------------------------------------------------------
# Brevo (https://app.brevo.com) sends sign-in links and reminders. MAIL_FROM
# must be a sender verified in Brevo, otherwise the API rejects the message.
# With no BREVO_API_KEY the app runs in outbox mode: messages are written to
# the `outbox` table and the sign-in link is shown on screen. Fine locally,
# NOT acceptable on a public deployment.
BREVO_API_KEY=
MAIL_FROM="FireLogbook <hello@yourdomain.co.uk>"

# --- Cron ------------------------------------------------------------------
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on cron runs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Billing ---------------------------------------------------------------
# Without these, checkout runs against a local simulator (no card, no charge).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Optional: pin a browser for PDF export if it is not in a standard location.
BROWSER_PATH=
